# ── Gemini API (Google AI Studio) ────────────────────────────
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Primary generation model. Prefix with 'openrouter:' to use OpenRouter.
PRIMARY_MODEL=openrouter:google/gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=vc_pokedex

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API. Do NOT use "*" — with
# credentials enabled that makes Starlette echo back any caller's origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Storage & Ingestion ──────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
MAX_EXTRACT_CHARS=60000

# ── OpenRouter (second LLM provider, optional) ────────────────
# Free tier: 20 req/min, 50 req/day. Buying any credits once raises the
# daily cap to 1,000. Leave blank to run on Gemini alone — OpenRouter legs
# in the model chain are skipped automatically when this is unset.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── External Scrapers (Optional) ─────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
# SEC requires a REAL contact address for programmatic access — replace this.
SEC_USER_AGENT="VCPokedex contact@example.com"
